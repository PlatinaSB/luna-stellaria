{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "luna-stellaria",
	"compatibility_date": "2026-04-19",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "luna-stellaria.com",
			"custom_domain": true
		}
	],

	"vars": {
		"ENVIRONMENT": "production",
		"PUBLIC_Turnstile_site_key": "0x4AAAAAAFZK5ULvx-AEBf7T"
	},

	"previews": {
		"vars": {
			"ENVIRONMENT": "preview",
			"PUBLIC_Turnstile_site_key": "0x4AAAAAAFZK5ULvx-AEBf7T"
		}
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
